# Local dev (Express backend running on your machine):
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Production (Vercel): set this in the Vercel dashboard under
# Project Settings → Environment Variables to your deployed Render backend URL, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://shetkari-sathi-backend.onrender.com/api/v1
#
# NEXT_PUBLIC_* variables are baked into the client bundle at build time, so
# this must be set in Vercel *before* the build/deploy runs.
