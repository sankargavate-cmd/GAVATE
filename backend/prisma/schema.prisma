// Prisma schema for SHETKARI SATHI
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  LABOUR
  TRACTOR_OWNER
  MACHINERY_PROVIDER
  BUYER
  TRANSPORT_PROVIDER
  ADMIN
  SUPER_ADMIN
}

// Tracks the admin review lifecycle of a LabourProfile, separately from the
// `isVerified` boolean that the farmer-facing search already relies on.
// PENDING = awaiting admin review (default for every new profile).
// APPROVED = admin verified; isVerified is kept in sync with this.
// REJECTED = admin declined; rejectionReason explains why.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Unit of measure for a ProduceListing's quantity/price (Step 18). Kept as
// a fixed enum (rather than free text) so buyer-side filtering and display
// stay consistent across listings.
enum ProduceUnit {
  KG
  QUINTAL
  TON
  DOZEN
  LITRE
  PIECE
}

// Lifecycle of a WorkRequest (Step 19). PENDING = awaiting the labour
// user's response (default for every new request). ACCEPTED/REJECTED =
// the labour user's decision. CANCELLED = withdrawn by the farmer who sent
// it. Terminal states (REJECTED, CANCELLED) are not re-enterable — only a
// PENDING request can be responded to, and only a PENDING or ACCEPTED
// request can be cancelled.
enum WorkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Lifecycle of a TractorBooking (Step 20). Mirrors WorkRequestStatus
// exactly — same PENDING/ACCEPTED/REJECTED/CANCELLED states, same
// terminal-state rules (REJECTED/CANCELLED are not re-enterable).
enum TractorBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Which of TractorProfile's two rate fields (ratePerHour / ratePerDay) a
// given TractorBooking was made against. Kept explicit on the booking
// (rather than inferred) since the owner's rates can change after a
// booking is made, but the agreed rate/rateType at booking time should
// not.
enum TractorRateType {
  HOURLY
  DAILY
}

// Unit of measure for a TransportProfile's vehicle capacity (Step 21).
// Mirrors ProduceUnit — kept as a fixed enum (rather than free text) so
// farmer-facing search/display stays consistent across listings.
enum CapacityUnit {
  KG
  QUINTAL
  TON
}

// Lifecycle of a TransportBooking (Step 21). Mirrors TractorBookingStatus /
// WorkRequestStatus exactly — same PENDING/ACCEPTED/REJECTED/CANCELLED
// states, same terminal-state rules (REJECTED/CANCELLED are not
// re-enterable).
enum TransportBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Which of TransportProfile's two rate fields (ratePerKm / ratePerTrip) a
// given TransportBooking was made against. Kept explicit on the booking
// (rather than inferred) since the provider's rates can change after a
// booking is made, but the agreed rate/rateType at booking time should
// not. Mirrors TractorRateType.
enum TransportRateType {
  PER_KM
  PER_TRIP
}

// Lifecycle of a ProduceOffer (Step 22). PENDING = awaiting the farmer's
// response (default for every new offer). ACCEPTED/REJECTED = the
// farmer's decision. WITHDRAWN = pulled back by the buyer who made it.
// Terminal states (REJECTED, WITHDRAWN) are not re-enterable — only a
// PENDING offer can be responded to or withdrawn. Mirrors
// WorkRequestStatus/TractorBookingStatus/TransportBookingStatus, with
// WITHDRAWN in place of CANCELLED since the buyer-side action here is
// pulling back an offer, not cancelling an agreed booking.
enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Lifecycle of an Order (Step 23). Created automatically the moment a
// ProduceOffer is ACCEPTED (see ProduceOffer.order below) — an order is
// never created any other way, so it always starts at PENDING. The happy
// path is a strict forward sequence: PENDING -> CONFIRMED -> READY ->
// PICKUP -> DELIVERED -> COMPLETED. CANCELLED is reachable only from
// PENDING or CONFIRMED (see order.service.ts's CANCELLABLE_STATUSES) —
// once produce is marked READY for pickup neither side can back out
// through this model. COMPLETED and CANCELLED are both terminal.
enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

// Which of the four booking/order types a Rating was made against (Step
// 25A). The rater is always a FARMER — this app's only party that engages
// Labour, Tractor, Transport and sells to Buyer — so this enum names the
// ratee's role rather than needing a separate raterRole field. Determines
// which of Rating's four nullable reference FKs (workRequestId /
// tractorBookingId / transportBookingId / orderId) is set.
enum RatingTargetType {
  LABOUR
  TRACTOR
  TRANSPORT
  BUYER
}

// Lifecycle of a Payment (Step 34 — Payment Gateway foundation).
// INITIATED = the record was created (a checkout attempt is about to
// begin) but nothing has happened at the gateway yet — the default for
// every new Payment. PENDING = the gateway has an attempt in progress
// (e.g. awaiting the user to complete a redirect/UPI flow). SUCCESS /
// FAILED = the gateway's final answer for that attempt. CANCELLED = the
// user or this app abandoned the attempt before the gateway resolved it.
// REFUNDED = a previously-SUCCESS payment was later reversed. Kept as a
// genuine Prisma enum (unlike Payment.purpose/relatedEntityType below)
// since — like OrderStatus/WorkRequestStatus — this is a small, fixed
// state machine intrinsic to what a "payment" is, not an open set new
// modules will extend.
enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

// Lifecycle of a *refund attempt* against a SUCCESS Payment (Step 41).
// Deliberately separate from PaymentStatus rather than reusing it:
// Cashfree's refund is its own async operation (create -> PENDING ->
// SUCCESS/FAILED, confirmed by its own webhook event/status check) that
// happens *after* a payment has already reached the terminal SUCCESS
// state — collapsing it into PaymentStatus would mean either marking a
// payment REFUNDED before Cashfree actually confirms it (trusting an
// unconfirmed request, which this app's payment rules never do) or
// having no way to represent "a refund is in flight but not yet
// confirmed" at all. PaymentStatus.REFUNDED (already existed, Step 34)
// remains the payment's own final state once a refund genuinely
// completes — set only when refundStatus reaches SUCCESS.
enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String
  role              Role
  emailVerified     Boolean  @default(false)
  preferredLanguage String   @default("en")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Stamped on every password change (self-service reset — auth.service.ts
  // resetPassword — and SUPER_ADMIN-issued reset — adminManagement.service.ts
  // resetAdminPassword). Null until the first password change. requireAuth
  // (auth.middleware.ts) rejects any JWT whose `iat` predates this
  // timestamp, so a stolen/leaked token is invalidated the moment the
  // password is changed instead of remaining valid until it naturally
  // expires.
  passwordChangedAt DateTime?

  // --- Location Engine foundation (Step 30) ---
  // Optional, coarse-to-fine location fields available on every User
  // regardless of role. Unlike FarmerProfile/LabourProfile/TractorProfile/
  // TransportProfile's own state/district/taluka/village/latitude/
  // longitude fields (which only exist for roles that have a profile
  // table), these let ANY authenticated user — including BUYER, which has
  // no profile model at all — save a location via a single, role-agnostic
  // API (location.service.ts). All six fields are optional so existing
  // users are never broken by this addition; a user may set none, some,
  // or all of them, and may set place-name fields without coordinates or
  // vice versa. Naming and types mirror the equivalent fields already on
  // those profile models exactly (String? for place names, Float? for
  // coordinates) for consistency across the codebase.
  state     String?
  district  String?
  taluka    String?
  village   String?
  latitude  Float?
  longitude Float?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  farmerProfile           FarmerProfile?
  labourProfile           LabourProfile?
  // One-to-one extension present only for TRACTOR_OWNER-role users (Step
  // 20) — mirrors labourProfile/farmerProfile above.
  tractorProfile          TractorProfile?
  // One-to-one extension present only for TRANSPORT_PROVIDER-role users
  // (Step 21) — mirrors tractorProfile above.
  transportProfile        TransportProfile?
  // Reverse side of ProduceListing.farmer (Step 18) — every produce
  // listing a FARMER-role user has created. Named implicitly (single
  // relation to ProduceListing from User), unlike the *VerifiedBy*
  // relations below which need explicit names because User has more than
  // one relation to those models.
  produceListings         ProduceListing[]
  // Reverse sides of WorkRequest.farmer / WorkRequest.labour (Step 19) —
  // every work request a FARMER-role user has sent, and every work
  // request a LABOUR-role user has received. Named relations since a
  // single User could in principle be on either side of the same table
  // (the relation field name alone wouldn't disambiguate which FK it maps
  // to), mirroring the *VerifiedBy* relations below.
  workRequestsSent        WorkRequest[]            @relation("WorkRequestFarmer")
  workRequestsReceived    WorkRequest[]            @relation("WorkRequestLabour")
  // Reverse sides of TractorBooking.farmer / TractorBooking.tractorOwner
  // (Step 20) — mirrors workRequestsSent/workRequestsReceived above, same
  // reasoning: a single User could in principle be on either side of the
  // same table.
  tractorBookingsSent     TractorBooking[]         @relation("TractorBookingFarmer")
  tractorBookingsReceived TractorBooking[]         @relation("TractorBookingOwner")
  // Reverse sides of TransportBooking.farmer / TransportBooking.transportProvider
  // (Step 21) — mirrors tractorBookingsSent/tractorBookingsReceived above,
  // same reasoning: a single User could in principle be on either side of
  // the same table.
  transportBookingsSent     TransportBooking[]      @relation("TransportBookingFarmer")
  transportBookingsReceived TransportBooking[]      @relation("TransportBookingProvider")
  // Reverse sides of ProduceOffer.buyer / ProduceOffer.farmer (Step 22) —
  // mirrors transportBookingsSent/transportBookingsReceived above, same
  // reasoning: a single User could in principle be on either side of the
  // same table (a BUYER-role user only ever sends, a FARMER-role user
  // only ever receives, but the relation names still need to disambiguate
  // which FK each maps to).
  produceOffersSent         ProduceOffer[]          @relation("ProduceOfferBuyer")
  produceOffersReceived     ProduceOffer[]          @relation("ProduceOfferFarmer")
  // Reverse sides of Order.buyer / Order.farmer (Step 23) — mirrors
  // produceOffersSent/produceOffersReceived above, same reasoning: a
  // single User could in principle be on either side of the same table (a
  // BUYER-role user only ever buys, a FARMER-role user only ever sells,
  // but the relation names still need to disambiguate which FK each maps
  // to).
  ordersAsBuyer             Order[]                 @relation("OrderBuyer")
  ordersAsFarmer            Order[]                 @relation("OrderFarmer")
  // Reverse side of Order.cancelledBy (Step 23) — every order this user
  // (buyer or farmer) has cancelled. Named relation since a User already
  // has two other (unrelated) relations to Order above.
  ordersCancelled           Order[]                 @relation("OrderCancelledBy")
  // Reverse side of OrderStatusHistory.changedBy (Step 23) — every status
  // change this user has made across any order they were party to.
  orderStatusChanges        OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  // Reverse sides of Rating.rater / Rating.ratee (Step 25A) — mirrors
  // ordersAsBuyer/ordersAsFarmer above, same reasoning: a single User
  // could in principle be on either side of the same table (a FARMER-role
  // user only ever rates, a LABOUR/TRACTOR_OWNER/TRANSPORT_PROVIDER/BUYER
  // -role user only ever gets rated, but the relation names still need to
  // disambiguate which FK each maps to).
  ratingsGiven               Rating[]                @relation("RatingRater")
  ratingsReceived             Rating[]                @relation("RatingRatee")
  // Reverse side of UserDocument.user (Step 26) — every KYC document this
  // user has submitted, across all document types. Single (unnamed)
  // relation since, unlike Rating/Order/etc., a document only ever has
  // one User side (the owner) — no second, disambiguating relation to the
  // same model exists on User.
  documents                  UserDocument[]
  // Reverse side of UserDocument.reviewedByAdmin (Step 27) — every KYC
  // document an ADMIN user has approved or rejected. Named relation since
  // a User already has a separate (unrelated) relation to UserDocument as
  // its owner, mirrors verifiedLabourProfiles/verifiedFarmerProfiles/
  // verifiedTractorProfiles/verifiedTransportProfiles above.
  reviewedDocuments           UserDocument[]         @relation("DocumentReviewedByAdmin")
  // Reverse side of LabourProfile.verifiedByAdmin — every LabourProfile an
  // ADMIN user has approved or rejected. Named relation since a User already
  // has a separate (unrelated) relation to LabourProfile as its owner.
  verifiedLabourProfiles  LabourProfile[]          @relation("LabourVerifiedByAdmin")
  // Reverse side of FarmerProfile.verifiedByAdmin (Step 17) — mirrors
  // verifiedLabourProfiles above, same reasoning: a User already has a
  // separate (unrelated) relation to FarmerProfile as its owner.
  verifiedFarmerProfiles  FarmerProfile[]          @relation("FarmerVerifiedByAdmin")
  // Reverse side of TractorProfile.verifiedByAdmin (Step 20) — mirrors
  // verifiedLabourProfiles/verifiedFarmerProfiles above.
  verifiedTractorProfiles TractorProfile[]         @relation("TractorVerifiedByAdmin")
  // Reverse side of TransportProfile.verifiedByAdmin (Step 21) — mirrors
  // verifiedTractorProfiles above.
  verifiedTransportProfiles TransportProfile[]     @relation("TransportVerifiedByAdmin")

  // --- Super Admin + Admin Management (Step 15) ---
  // One-to-one extension present only for ADMIN-role users; mirrors the
  // FarmerProfile/LabourProfile pattern above. SUPER_ADMIN users never have
  // one of these (they aren't managed by anyone via this workflow).
  adminProfile          AdminProfile?
  // Reverse sides of AdminProfile.createdByAdmin / .removedByAdmin — every
  // AdminProfile a given SUPER_ADMIN user has created or removed access
  // for. Named relations since a User already has other relations to
  // AdminProfile (its own, as the managed admin).
  createdAdminProfiles  AdminProfile[]           @relation("AdminCreatedByAdmin")
  removedAdminProfiles  AdminProfile[]           @relation("AdminRemovedByAdmin")

  // Reverse side of Notification.recipient (Step 32) — every in-app
  // notification addressed to this user, regardless of role or which
  // future module created it. Single (unnamed) relation since, like
  // UserDocument's `documents` above, a Notification only has one User
  // side (the recipient) — no second, disambiguating relation to the
  // same model exists on User.
  notifications Notification[]

  // Reverse side of Payment.user (Step 34) — every payment this user has
  // initiated, regardless of purpose or gateway. Single (unnamed)
  // relation, same reasoning as `notifications`/`documents` above: a
  // Payment only has one User side (the payer).
  payments Payment[]

  @@index([role])
  @@index([isActive])
  @@index([state, district])
  @@map("users")
}

// One-to-one extension of User for FARMER-role accounts. Kept as a separate
// table (rather than fields on User) since these fields are meaningless for
// non-farmer roles (Labour, Buyer, Tractor Owner, ...).
model FarmerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  profilePhoto      String?
  mobile            String
  state             String
  district          String
  taluka            String
  village           String
  address           String
  latitude          Float?
  longitude         Float?
  farmingExperience Int
  // Set only by the admin verification workflow (Step 17) — farmer users
  // cannot set this on themselves via createFarmerProfile/update. Kept in
  // sync with verificationStatus (true iff APPROVED), mirroring
  // LabourProfile.isVerified, so any future farmer-facing search/listing
  // can filter on this field directly.
  isVerified        Boolean  @default(false)

  // --- Admin verification workflow (Step 17) ---
  verificationStatus VerificationStatus @default(PENDING)
  // Required when verificationStatus is REJECTED; null otherwise. Cleared
  // if a previously-rejected profile is later approved.
  rejectionReason    String?
  // When the admin decision (approve or reject) was made; null while PENDING.
  verifiedAt         DateTime?
  // Which admin made the decision; null while PENDING.
  verifiedByAdminId  String?
  verifiedByAdmin    User?              @relation("FarmerVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, district])
  @@index([verificationStatus])
  @@map("farmer_profiles")
}

// One-to-one extension of User for LABOUR-role accounts. Farmers search this
// table directly (isVerified + isAvailable), so the fields here double as
// the marketplace listing, not just an internal profile.
model LabourProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  profilePhoto    String?
  mobile          String
  skills          String[] @default([])
  experienceYears Int?
  state           String
  district        String
  taluka          String
  village         String
  address         String
  latitude        Float?
  longitude       Float?
  dailyWage       Float
  isAvailable     Boolean  @default(true)
  // Set only by the admin verification workflow (Step 13) — labour users
  // cannot set this on themselves via createLabourProfile/update. Kept in
  // sync with verificationStatus (true iff APPROVED) since the farmer
  // search endpoint filters on this field directly.
  isVerified      Boolean  @default(false)

  // --- Ratings & Reviews (Step 25A) ---
  // Cached aggregate over every Rating targeting this user with
  // targetType LABOUR — recomputed by rating.service.ts after every
  // create/update/delete so farmer-facing search/display never has to run
  // a live aggregate query. null (not 0) while ratingCount is 0, so
  // "no ratings yet" is distinguishable from "rated 0".
  averageRating Float?
  ratingCount   Int    @default(0)

  // --- Admin verification workflow (Step 13) ---
  verificationStatus VerificationStatus @default(PENDING)
  // Required when verificationStatus is REJECTED; null otherwise. Cleared
  // if a previously-rejected profile is later approved.
  rejectionReason    String?
  // When the admin decision (approve or reject) was made; null while PENDING.
  verifiedAt         DateTime?
  // Which admin made the decision; null while PENDING.
  verifiedByAdminId  String?
  verifiedByAdmin    User?              @relation("LabourVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, district])
  @@index([isVerified, isAvailable])
  @@index([dailyWage])
  @@index([verificationStatus])
  @@map("labour_profiles")
}

// A farmer's produce listing in the marketplace (Step 18). Unlike
// FarmerProfile/LabourProfile, this is one-to-many — a farmer can list
// multiple crops at once — so it is its own top-level model rather than a
// one-to-one profile extension.
//
// "Verified" on the buyer-facing side (search/detail) is derived from the
// listing owner's FarmerProfile.isVerified (Step 17's admin verification
// workflow), not a field on this model — there is no separate per-listing
// verification step in this phase. isActive is the only listing-level
// visibility switch, letting a farmer pull a listing down (sold out, no
// longer available) without deleting its history.
model ProduceListing {
  id          String      @id @default(cuid())
  farmerId    String
  crop        String
  quantity    Float
  unit        ProduceUnit
  price       Float
  location    String
  description String?
  photos      String[]    @default([])
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer User @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  // Reverse side of ProduceOffer.listing (Step 22) — every offer a buyer
  // has made on this listing.
  offers ProduceOffer[]
  // Reverse side of Order.listing (Step 23) — every order created from an
  // accepted offer on this listing.
  orders Order[]

  @@index([farmerId])
  @@index([crop])
  @@index([isActive])
  @@index([location])
  @@map("produce_listings")
}

// A buyer's offer on a farmer's produce listing (Step 22). One-directional:
// created only by a BUYER, targeted at a specific ProduceListing (Step 18)
// — not just the farmer, since a farmer can have many listings and an
// offer is scoped to exactly one of them. Kept as its own top-level model,
// same reasoning as WorkRequest/TractorBooking/TransportBooking:
// one-to-many on both sides (a buyer can make many offers; a listing can
// receive many offers), so neither side can be a one-to-one extension.
model ProduceOffer {
  id        String @id @default(cuid())
  listingId String
  buyerId   String
  // Denormalized from listing.farmerId at offer-creation time, so the
  // farmer's "received offers" view can query ProduceOffer directly by
  // farmerId without joining through ProduceListing every time — mirrors
  // farmerId/tractorOwnerId being stored directly on TractorBooking rather
  // than derived through another relation.
  farmerId  String

  // Buyer's proposed price per unit (same unit as the listing) and
  // quantity — independent of the listing's own price/quantity, since an
  // offer is a negotiation, not necessarily a match to what's listed.
  offerPrice Float
  quantity   Float
  // Optional note from the buyer to the farmer. Never required.
  message    String?

  status OfferStatus @default(PENDING)
  // When the farmer accepted or rejected; null while PENDING.
  respondedAt DateTime?
  // When the buyer withdrew; null unless status is WITHDRAWN.
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing ProduceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User            @relation("ProduceOfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  farmer  User            @relation("ProduceOfferFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  // Reverse side of Order.offer (Step 23) — the order created the moment
  // this offer was ACCEPTED. Optional/one-to-one: null for every offer
  // that is still PENDING, REJECTED, or WITHDRAWN — only an ACCEPTED
  // offer ever gets one, and it gets exactly one (Order.offerId is
  // @unique).
  order Order?

  @@index([listingId])
  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
  @@map("produce_offers")
}

// A confirmed purchase created automatically the moment a buyer's
// ProduceOffer is ACCEPTED (Step 23) — see
// produceOffer.service.ts:respondToProduceOffer, which creates this in the
// same transaction as the offer's ACCEPTED update. Kept as its own
// top-level model (not fields bolted onto ProduceOffer) because an order
// has its own independent lifecycle (OrderStatus) that is considerably
// longer and more granular than OfferStatus, plus its own audit trail
// (OrderStatusHistory) — folding that onto ProduceOffer would conflate
// "was this offer accepted" with "how is fulfilment going".
//
// crop/unit/quantity/pricePerUnit/totalAmount are all denormalized at
// creation time from the listing (crop, unit) and the accepted offer
// (quantity, offerPrice) — the agreed terms of the sale, frozen at the
// moment of acceptance so they can't drift if the listing is edited or
// deleted afterward. Mirrors why TractorBooking/TransportBooking snapshot
// their agreed rate/rateType rather than pointing back at the profile's
// current rates.
model Order {
  id        String @id @default(cuid())
  offerId   String @unique
  listingId String
  buyerId   String
  farmerId  String

  crop         String
  quantity     Float
  unit         ProduceUnit
  pricePerUnit Float
  totalAmount  Float

  status OrderStatus @default(PENDING)

  // Set as the order enters each forward-path status (see
  // order.service.ts's STATUS_TIMESTAMP_FIELD) — null until that status is
  // reached, and never cleared afterward even if a later mutation occurs,
  // so each remains a permanent record of when that step happened.
  confirmedAt DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?

  // Set only if status is CANCELLED; null otherwise. Mirrors
  // WorkRequest/TractorBooking/TransportBooking's cancelledAt, plus a
  // reason (optional, buyer/farmer-supplied) and who performed the
  // cancellation, since either party can cancel here (unlike those
  // booking models, where only the requesting farmer can).
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?
  cancelledBy        User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer   ProduceOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  listing ProduceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User           @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  farmer  User           @relation("OrderFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  // Every status change this order has ever gone through, oldest first —
  // the append-only audit trail behind the "order history" feature
  // (order.service.ts:getOwnOrderHistory), independent of the point-in-time
  // snapshot the fields above give.
  statusHistory OrderStatusHistory[]
  // Reverse side of Rating.orderId (Step 25A) — at most one, since that
  // FK is @unique (one rating per order). Always a farmer-rates-buyer
  // rating (targetType BUYER) — Order is the only completed-engagement
  // record between those two roles.
  rating        Rating?

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([status])
  @@map("orders")
}

// One row per status transition an Order goes through (Step 23) —
// append-only, never updated or deleted once written, so it can serve as
// a permanent audit trail independent of the point-in-time status fields
// on Order itself. Includes the initial PENDING row written the moment
// the order is created, so an order's full history (including its own
// creation) can always be read from one place.
model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus
  // Optional context for this particular transition — e.g. a farmer's
  // note when marking READY, or a cancellation reason. Distinct from
  // Order.cancellationReason, which is the current/latest reason only;
  // this is that same text preserved permanently against its specific
  // history row.
  note String?

  changedById String
  changedBy   User   @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// A farmer's request to hire a specific labour user for a piece of work
// (Step 19). One-directional: created only by a FARMER, targeted at a
// specific LABOUR-role user (not a LabourProfile row — the profile can
// change over time, but the request always points at the person). Kept as
// its own top-level model, same reasoning as ProduceListing: one-to-many
// on both sides (a farmer can send many requests; a labour user can
// receive many), so neither side can be a one-to-one profile extension.
model WorkRequest {
  id       String @id @default(cuid())
  farmerId String
  labourId String

  // Free-text description of the job (e.g. "Harvesting", "Weeding") rather
  // than an enum — mirrors LabourProfile.skills being free-text tags
  // rather than a fixed list, since the range of farm work is open-ended.
  workType String
  workDate DateTime
  location String
  wage     Float
  // Optional note from the farmer to the labour user (e.g. specific
  // instructions). Never required.
  message  String?

  status WorkRequestStatus @default(PENDING)
  // When the labour user accepted or rejected; null while PENDING.
  respondedAt DateTime?
  // When the farmer cancelled; null unless status is CANCELLED.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer User @relation("WorkRequestFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  labour User @relation("WorkRequestLabour", fields: [labourId], references: [id], onDelete: Cascade)
  // Reverse side of Rating.workRequestId (Step 25A) — at most one, since
  // that FK is @unique (one rating per booking).
  rating Rating?

  @@index([farmerId])
  @@index([labourId])
  @@index([status])
  @@index([workDate])
  @@map("work_requests")
}

// One-to-one extension of User for TRACTOR_OWNER-role accounts (Step 20).
// Farmers search this table directly (isVerified + isAvailable), exactly
// like LabourProfile — the fields here double as the marketplace listing,
// not just an internal profile.
model TractorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  photos          String[] @default([])
  mobile          String
  // Free-text rather than an enum — the range of tractor makes/models
  // (and how owners describe them, e.g. "4WD Mini" vs "Mahindra 275 DI")
  // is open-ended, mirrors LabourProfile.skills being free text.
  tractorType     String
  model           String
  state           String
  district        String
  taluka          String
  village         String
  address         String
  latitude        Float?
  longitude       Float?
  // At least one of the two must be set (enforced in the validator, not
  // the DB) — an owner can quote hourly, daily, or both.
  ratePerHour     Float?
  ratePerDay      Float?
  isAvailable     Boolean  @default(true)
  // Set only by the admin verification workflow — tractor owners cannot
  // set this on themselves via createTractorProfile/update. Kept in sync
  // with verificationStatus (true iff APPROVED), mirroring
  // LabourProfile.isVerified, since the farmer-facing search endpoint
  // filters on this field directly.
  isVerified      Boolean  @default(false)

  // --- Ratings & Reviews (Step 25A) ---
  // Cached aggregate over every Rating targeting this user with
  // targetType TRACTOR. Mirrors LabourProfile.averageRating/ratingCount —
  // same reasoning, same recompute trigger.
  averageRating Float?
  ratingCount   Int    @default(0)

  // --- Admin verification workflow (Step 20) ---
  verificationStatus VerificationStatus @default(PENDING)
  // Required when verificationStatus is REJECTED; null otherwise. Cleared
  // if a previously-rejected profile is later approved.
  rejectionReason    String?
  // When the admin decision (approve or reject) was made; null while PENDING.
  verifiedAt         DateTime?
  // Which admin made the decision; null while PENDING.
  verifiedByAdminId  String?
  verifiedByAdmin    User?              @relation("TractorVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, district])
  @@index([isVerified, isAvailable])
  @@index([verificationStatus])
  @@map("tractor_profiles")
}

// A farmer's request to book a specific tractor owner's tractor (Step 20).
// One-directional: created only by a FARMER, targeted at a specific
// TRACTOR_OWNER-role user (not a TractorProfile row — the profile can
// change over time, but the booking always points at the person). Mirrors
// WorkRequest exactly, same reasoning: one-to-many on both sides, so
// neither side can be a one-to-one profile extension.
model TractorBooking {
  id             String @id @default(cuid())
  farmerId       String
  tractorOwnerId String

  // Free-text purpose of the booking (e.g. "Ploughing", "Sowing"),
  // mirrors WorkRequest.workType.
  workType    String
  bookingDate DateTime
  location    String
  // Which of the owner's two rates this booking was agreed against, and
  // the actual agreed amount for that unit — kept explicit on the
  // booking (rather than re-read from the live profile) since the
  // owner's rates can change after a booking is made.
  rateType    TractorRateType
  rate        Float
  // Optional note from the farmer to the tractor owner. Never required.
  message     String?

  status TractorBookingStatus @default(PENDING)
  // When the tractor owner accepted or rejected; null while PENDING.
  respondedAt DateTime?
  // When the farmer cancelled; null unless status is CANCELLED.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer       User @relation("TractorBookingFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  tractorOwner User @relation("TractorBookingOwner", fields: [tractorOwnerId], references: [id], onDelete: Cascade)
  // Reverse side of Rating.tractorBookingId (Step 25A) — at most one,
  // since that FK is @unique (one rating per booking).
  rating       Rating?

  @@index([farmerId])
  @@index([tractorOwnerId])
  @@index([status])
  @@index([bookingDate])
  @@map("tractor_bookings")
}

// One-to-one extension of User for TRANSPORT_PROVIDER-role accounts (Step
// 21). Farmers search this table directly (isVerified + isAvailable),
// exactly like TractorProfile — the fields here double as the marketplace
// listing, not just an internal profile.
model TransportProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  photos          String[] @default([])
  mobile          String
  // Free-text rather than an enum — the range of vehicle types (e.g. "Mini
  // Truck", "Tempo", "Container Truck") and how providers describe them is
  // open-ended, mirrors TractorProfile.tractorType being free text.
  vehicleType     String
  vehicleNumber   String
  capacity        Float
  capacityUnit    CapacityUnit
  state           String
  district        String
  taluka          String
  village         String
  address         String
  latitude        Float?
  longitude       Float?
  // At least one of the two must be set (enforced in the validator, not
  // the DB) — a provider can quote per-km, per-trip, or both. Mirrors
  // TractorProfile.ratePerHour/ratePerDay.
  ratePerKm       Float?
  ratePerTrip     Float?
  isAvailable     Boolean  @default(true)
  // Set only by the admin verification workflow — transport providers
  // cannot set this on themselves via createTransportProfile/update. Kept
  // in sync with verificationStatus (true iff APPROVED), mirroring
  // TractorProfile.isVerified, since the farmer-facing search endpoint
  // filters on this field directly.
  isVerified      Boolean  @default(false)

  // --- Ratings & Reviews (Step 25A) ---
  // Cached aggregate over every Rating targeting this user with
  // targetType TRANSPORT. Mirrors TractorProfile.averageRating/ratingCount
  // — same reasoning, same recompute trigger.
  averageRating Float?
  ratingCount   Int    @default(0)

  // --- Admin verification workflow (Step 21) ---
  verificationStatus VerificationStatus @default(PENDING)
  // Required when verificationStatus is REJECTED; null otherwise. Cleared
  // if a previously-rejected profile is later approved.
  rejectionReason    String?
  // When the admin decision (approve or reject) was made; null while PENDING.
  verifiedAt         DateTime?
  // Which admin made the decision; null while PENDING.
  verifiedByAdminId  String?
  verifiedByAdmin    User?              @relation("TransportVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, district])
  @@index([isVerified, isAvailable])
  @@index([verificationStatus])
  @@map("transport_profiles")
}

// A farmer's request to book a specific transport provider's vehicle
// (Step 21). One-directional: created only by a FARMER, targeted at a
// specific TRANSPORT_PROVIDER-role user (not a TransportProfile row — the
// profile can change over time, but the booking always points at the
// person). Mirrors TractorBooking exactly, same reasoning: one-to-many on
// both sides, so neither side can be a one-to-one profile extension.
// Unlike TractorBooking's single `location`, this carries separate pickup
// and drop locations since a transport job inherently has both.
model TransportBooking {
  id                 String @id @default(cuid())
  farmerId           String
  transportProviderId String

  // Free-text description of what's being moved (e.g. "Produce
  // transport", "Fertilizer delivery"), mirrors TractorBooking.workType.
  goodsType      String
  pickupLocation String
  dropLocation   String
  bookingDate    DateTime
  // Which of the provider's two rates this booking was agreed against,
  // and the actual agreed amount for that unit — kept explicit on the
  // booking (rather than re-read from the live profile) since the
  // provider's rates can change after a booking is made.
  rateType       TransportRateType
  rate           Float
  // Optional note from the farmer to the transport provider. Never required.
  message        String?

  status TransportBookingStatus @default(PENDING)
  // When the transport provider accepted or rejected; null while PENDING.
  respondedAt DateTime?
  // When the farmer cancelled; null unless status is CANCELLED.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer            User @relation("TransportBookingFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  transportProvider User @relation("TransportBookingProvider", fields: [transportProviderId], references: [id], onDelete: Cascade)
  // Reverse side of Rating.transportBookingId (Step 25A) — at most one,
  // since that FK is @unique (one rating per booking).
  rating            Rating?

  @@index([farmerId])
  @@index([transportProviderId])
  @@index([status])
  @@index([bookingDate])
  @@map("transport_bookings")
}

// A farmer's rating + optional written review of a Labour, Tractor,
// Transport, or Buyer counterparty, left against one specific completed
// engagement (Step 25A). One-directional like every booking model in this
// app: the rater is always a FARMER (the only role that engages all four
// of Labour/Tractor/Transport/Buyer), so there is no separate raterRole
// field — targetType alone names which kind of ratee this is.
//
// The engagement being rated is referenced by exactly one of the four
// nullable FKs below, matching targetType (LABOUR -> workRequestId,
// TRACTOR -> tractorBookingId, TRANSPORT -> transportBookingId, BUYER ->
// orderId) — enforced in rating.service.ts, not the DB, since Prisma has
// no native "exactly one of N nullable FKs" constraint. Each FK is
// individually @unique, which is what actually prevents duplicate ratings
// at the DB level: a given booking/order id can appear on at most one
// Rating row regardless of which FK it's stored in (Postgres unique
// constraints allow unlimited NULLs, so the three unset FKs on any given
// row never collide).
// Which kind of document a UserDocument row represents (Step 26 — KYC
// foundation). Deliberately one flat enum shared across every role
// (rather than a separate enum per role) since a handful of types
// (AADHAAR_CARD, PAN_CARD, PROFILE_PHOTO) are common to all roles and the
// role-specific ones only number one or two each — validators.document
// validator.ts is what actually restricts which of these a given role
// may submit, not the enum itself.
enum DocumentType {
  // Common to every role
  AADHAAR_CARD
  PAN_CARD
  PROFILE_PHOTO
  BANK_PASSBOOK
  // Farmer-specific: proof of land ownership/tenancy.
  SEVEN_TWELVE_EXTRACT
  LAND_OWNERSHIP_PROOF
  // Labour/Tractor Owner/Transport Provider-specific.
  DRIVING_LICENSE
  // Tractor Owner-specific: vehicle registration certificate.
  TRACTOR_RC
  // Transport Provider-specific.
  VEHICLE_RC
  TRANSPORT_PERMIT
  // Buyer-specific: business proof.
  GST_CERTIFICATE
  SHOP_ESTABLISHMENT_LICENSE
  OTHER
}

// A single KYC document a user has submitted for admin review (Step 26
// foundation; admin review endpoints added in Step 27). Mirrors
// LabourProfile/FarmerProfile/TractorProfile/TransportProfile's existing
// VerificationStatus review lifecycle, but as its own table (rather than
// fields on those profiles) since a user may submit many documents of
// different types, and this model applies uniformly across all five
// roles (Farmer, Labour, Buyer, Tractor Owner, Transport Provider) rather
// than being profile-specific.
model UserDocument {
  id       String       @id @default(cuid())
  userId   String
  documentType DocumentType
  // Path/URL to the uploaded file in whatever storage backend the client
  // uploaded it to (e.g. S3/Cloudinary) — this API registers the
  // reference, it does not handle the binary upload itself, mirroring how
  // profilePhoto/photos URL fields work elsewhere in this codebase
  // (farmer.validator.ts, produce.validator.ts, tractor.validator.ts).
  documentUrl String

  status          VerificationStatus @default(PENDING)
  // Required once status is REJECTED; null otherwise. Cleared if a
  // previously-rejected document is later approved. Mirrors
  // LabourProfile.rejectionReason.
  rejectionReason String?

  uploadedAt DateTime  @default(now())
  // When the admin decision (approve or reject) was made; null while
  // still PENDING.
  reviewedAt DateTime?
  // Which admin made the approve/reject decision; null while PENDING.
  // Mirrors LabourProfile.verifiedByAdminId.
  reviewedByAdminId String?
  reviewedByAdmin   User?   @relation("DocumentReviewedByAdmin", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@map("user_documents")
}

model Rating {
  id      String            @id @default(cuid())
  raterId String
  rateeId String
  targetType RatingTargetType

  // Exactly one is set, per targetType — see model doc comment above.
  workRequestId      String? @unique
  tractorBookingId   String? @unique
  transportBookingId String? @unique
  orderId            String? @unique

  // 1-5 star rating; required on every row (a review can't exist without
  // a numeric rating, mirrors how e-commerce reviews work).
  rating Int
  // Optional written feedback. Never required — a farmer can leave a bare
  // star rating with no text.
  review String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rater User @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)

  workRequest      WorkRequest?      @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  tractorBooking   TractorBooking?   @relation(fields: [tractorBookingId], references: [id], onDelete: Cascade)
  transportBooking TransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([rateeId])
  @@index([raterId])
  @@index([targetType])
  @@map("ratings")
}

// One-to-one extension of User for ADMIN-role accounts, created and
// managed exclusively by SUPER_ADMIN users (Step 15). Does not exist for
// SUPER_ADMIN users themselves — this table is the *managed* side of the
// relationship, not a generic "admin metadata" table.
model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  // Free-form allow-list of feature-scoped permission strings (e.g.
  // "LABOUR_VERIFICATION_MANAGE"). Validated against a fixed known set at
  // the application layer (adminManagement.validator.ts), not enforced by
  // the DB. Admin-management itself is never a grantable permission here —
  // only SUPER_ADMIN can manage admins, by role, not by permission.
  permissions String[] @default([])
  // Set true whenever a SUPER_ADMIN resets this admin's password, so a
  // future login flow can require a change before continuing. Metadata
  // only in this step — not yet enforced at login (Step 15 does not touch
  // existing auth/login logic).
  mustChangePassword Boolean @default(false)

  // Which SUPER_ADMIN created this admin account; null if unknown (e.g.
  // the referenced super admin account was later deleted).
  createdByAdminId String?
  createdByAdmin   User?   @relation("AdminCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  // Soft-revocation: set when a SUPER_ADMIN removes this admin's access.
  // Distinct from `user.isActive` (temporary suspend/reactivate) — a
  // removed admin is also deactivated, but removal additionally records
  // who revoked access and when, and is treated as a one-way action by the
  // service layer (removed admins cannot be reactivated via the
  // activate/deactivate endpoints, only re-created).
  removedAt        DateTime?
  removedByAdminId String?
  removedByAdmin   User?     @relation("AdminRemovedByAdmin", fields: [removedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([removedAt])
  @@map("admin_profiles")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Notification Engine foundation (Step 32). A single in-app notification
// addressed to one recipient. Deliberately generic and role-agnostic (any
// User, regardless of role, can be a recipient) so this one table and its
// service (notification.service.ts) can be reused by every future module
// that needs to notify a user — Labour, Tractor, Transport, Buyer, Order,
// Payment, KYC, etc. — without a new table or migration per module.
//
// `type` and `relatedEntityType` are plain Strings, not Prisma enums —
// same reasoning as AdminProfile.permissions: the allow-list of valid
// values (NOTIFICATION_TYPES / NOTIFICATION_ENTITY_TYPES in
// constants/notification.ts) is enforced at the application layer and can
// grow as new modules start creating notifications, without a schema
// migration each time.
//
// This step is the foundation only: the model, service, and read/list/
// mark-as-read APIs. No module yet calls createNotification() for real
// events, and no delivery channel (email/Web Push/FCM/SMS) is wired up —
// those are explicitly out of scope here.
model Notification {
  id          String @id @default(cuid())
  recipientId String

  type    String
  title   String
  message String

  // Read/unread status. isRead is the field every list/count query
  // filters or groups on; readAt additionally records *when* it was read
  // (null while unread), mirroring the isUsed-style boolean + timestamp
  // pairing already used elsewhere in this schema (e.g.
  // EmailVerificationToken.usedAt).
  isRead Boolean   @default(false)
  readAt DateTime?

  // Optional pointer to the domain object this notification is about
  // (e.g. a WorkRequest id, TractorBooking id, Order id, UserDocument
  // id). Always set together or left both null — enforced by
  // createNotification()/createBulkNotifications() in
  // notification.service.ts, not by the DB, since which table
  // relatedEntityId points into varies by relatedEntityType and this
  // model has no single FK relation it could otherwise be. Kept as free
  // Strings (rather than a Prisma relation) for the same reason `type`
  // is a String: a single Notification may reference any one of many
  // unrelated models depending on which future module created it.
  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Composite index leading on recipientId covers every read path this
  // step needs: a recipient's own paginated list ordered by recency
  // (recipientId + createdAt), and unread-only / unread-count queries
  // (recipientId + isRead, with createdAt already available for the same
  // index for a free ORDER BY). A recipientId-only lookup is also
  // satisfied by this index's leading column, so no separate
  // single-column index is needed.
  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

// Payment Gateway foundation (Step 34). Reusable across every payable
// flow in this app (WorkRequest, TractorBooking, TransportBooking,
// produce Order) rather than a payment table per module — mirrors why
// Notification (Step 32) is one shared model rather than one per
// module. This step is the foundation only: the model, the service
// (payment.service.ts: createPaymentRecord/getMyPayments/
// getPaymentById/updatePaymentStatus), and a read-only "my payments"
// API. No gateway (Cashfree or otherwise) is connected, no checkout
// flow exists, and nothing in Order/WorkRequest/TractorBooking/
// TransportBooking calls into this yet — those are explicitly out of
// scope here.
model Payment {
  id     String @id @default(cuid())
  userId String

  amount   Float
  // ISO 4217 currency code. Defaulted to INR since every payable flow
  // in this app today is domestic, but kept as a field (not hardcoded)
  // so a future gateway/currency isn't a schema change.
  currency String @default("INR")

  // Coarse business reason this payment exists (e.g.
  // "TRACTOR_BOOKING_PAYMENT") — String with an app-enforced allow-list
  // (PAYMENT_PURPOSES in constants/payment.ts) rather than a Prisma
  // enum, mirroring Notification.type, so future payable flows
  // (platform fees, subscriptions, ...) can be added without a
  // migration.
  purpose String

  // Optional pointer to the domain object this payment is for (e.g. a
  // WorkRequest/TractorBooking/TransportBooking/Order id). Always set
  // together or left both null — enforced by createPaymentRecord() in
  // payment.service.ts, not the DB, mirroring
  // Notification.relatedEntityType/relatedEntityId exactly: which table
  // relatedEntityId points into varies by relatedEntityType, and this
  // model has no single FK relation it could otherwise be.
  relatedEntityType String?
  relatedEntityId   String?

  // Which payment gateway processed (or will process) this payment.
  // Free text rather than a fixed enum since no gateway is integrated
  // yet (this step is foundation-only) — the actual set of supported
  // gateway names is a decision for the step that wires one up.
  gatewayName String?

  // The gateway's own identifiers for this payment. Two separate fields
  // since gateways (Cashfree included) commonly distinguish an
  // "order"/reference id created up front from the "payment" id
  // assigned only once a specific payment attempt is made against it.
  // Both null until a future checkout step sets them.
  gatewayReferenceId String?
  gatewayPaymentId   String?

  status PaymentStatus @default(INITIATED)

  // Populated when status is FAILED (or another unsuccessful terminal
  // state) — the gateway's or this app's own reason, surfaced back to
  // the user. Null while INITIATED/PENDING/SUCCESS.
  failureReason String?

  // Refund tracking (Step 41). All null/PENDING-untouched until a
  // refund is actually initiated against this Payment — a Payment that
  // was never refunded has refundStatus == null. Mirrors the existing
  // gatewayReferenceId/gatewayPaymentId split: gatewayRefundId is
  // Cashfree's own id for the refund object, separate from
  // gatewayPaymentId (the original payment attempt's id).
  refundStatus    RefundStatus?
  refundAmount    Float?
  // Always sourced from this Payment's own `amount` at refund-initiation
  // time (see cashfreePayment.service.ts) — never a client-supplied
  // value, so a refund can never be issued for more (or less, silently)
  // than what was actually captured.
  refundReason    String?
  gatewayRefundId String?
  refundedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId: a user's own paginated "my payments" list, most recent
  // first. status: filtering/reconciliation by lifecycle state.
  // gatewayReferenceId: looking a payment up by the id a gateway
  // webhook/callback carries back. relatedEntityType+relatedEntityId:
  // "has this booking/order already been paid for" lookups from other
  // modules. gatewayRefundId: looking a payment up by the id a refund
  // webhook carries back, mirroring gatewayReferenceId's own index.
  @@index([userId, createdAt])
  @@index([status])
  @@index([gatewayReferenceId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([gatewayRefundId])
  @@map("payments")
}
