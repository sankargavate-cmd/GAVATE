NODE_ENV=development
# Render provides PORT automatically at runtime; this value is only used locally.
PORT=5000

# PostgreSQL connection string
# Local dev format:      postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Render production:     use the "Internal Database URL" from your Render Postgres
#                         instance (same region as the web service) so traffic never
#                         leaves Render's network. Render injects this automatically
#                         if you link the database to the web service via render.yaml
#                         or the dashboard's "Environment" tab.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shetkari_sathi?schema=public"

# Frontend origin(s) allowed to call this API. Comma-separate multiple values
# to allow both the Vercel production URL and preview-deployment URLs, e.g.:
# CORS_ORIGIN="https://shetkari-sathi.vercel.app,https://shetkari-sathi-git-preview-yourteam.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Base URL of the frontend, used to build links inside emails.
# In production, set this to your Vercel production URL.
FRONTEND_URL="http://localhost:3000"

# Email verification
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Email sending provider. Only "console" (logs instead of sending) is
# implemented so far — safe for local development, no real emails sent.
EMAIL_PROVIDER="console"

# JWT access tokens issued on login. Use a long, random, unguessable string
# in real environments — never commit the real secret.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Cashfree Payment Gateway (Step 35 — integration foundation).
# "sandbox" for testing, "production" for real money movement. Defaults
# to "sandbox" if unset, so this can never accidentally point at
# production by omission.
CASHFREE_ENV="sandbox"
# Generate these from the Cashfree Merchant Dashboard (Developers > API Keys).
# NEVER commit real values here or anywhere else in this repo.
CASHFREE_CLIENT_ID="replace-with-your-cashfree-client-id"
CASHFREE_CLIENT_SECRET="replace-with-your-cashfree-client-secret"
# API version Cashfree expects on every REST call (format YYYY-MM-DD).
CASHFREE_API_VERSION="2025-01-01"
